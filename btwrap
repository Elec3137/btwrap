#!/usr/bin/env fish

function print_usage
    printf 'Shell wrapper for btrfs snapshots (creation, cleanup, space usage polling)

Options
    -q            quiet (suppress extra warnings and all confirmations)
    -h            display this help

Actions
    -C <dir>      create a ".snapshots" subvolume to stage it for snapshotting

For each ".snapshots" subvolume: (or specify a subvolume with -p <path>)
    -S            take a snapshot (optionally use -n <name> to specify a name)
    -D            delete the oldest snapshot
    -L            list all snapshots
    -U            poll for a disk usage summary

Other
    -G            update grub (for grub-btrfs)
    -E <dir>     exclude from any future parent snapshots by converting target into a subvolume


Example usage
btwrap -C /home     # creates subvolume /home/.snapshots
btwrap -Sp /home    # snapshots /home subvolume into /home/.snapshots
btwrap -SD          # for each staged subvolume: snapshot it, then delete the oldest snapshot'
end

function err --description 'prints the given error message'
    set_color brred
    echo $argv
    set_color normal
end

function info --description 'prints info in cyan' # TODO don't print if quiet argument is recieved
    set_color cyan
    echo $argv
    set_color normal
end

function confirm --description 'asks for use input, returns 0 (yes) or 1 (no).' # TODO return 0 if not interactive
    set_color cyan
    echo -n "$argv [y/N]" # TODO consider implementing "all" option
    set_color normal

    read response
    if string match -qr 'y|ye|yes' $(string lower $response)
        return 0
    else
        return 1
    end
end

function sfd --description 'finds only toplevel directories with the name ".snapshots"'
    sudo btrfs subv list / | grep snapshots\$ | cut -d " " -f 9 | cut -d '@' -f 2
end

function subvCreate # create
    subvConvert "$argv"
    sudo btrfs subv create "$argv/.snapshots"
end

function snapTake --description snapshot
    if [ -z "$path" ] # if $path is empty
        for i in $(sfd)
            sudo btrfs subv snap -r "/$i/../" "/$i/$name$(random)"
        end
    else
        sudo btrfs subv snap -r "$path" "$path/.snapshots/$name$(random)"
    end
end

function snapDelete --description delete
    # setting of (deletion) $target needs a weird "echo" (to output it all at once to awk?)
    # and echoed command MUST NOT be in double quotes (why?)

    if [ -z "$path" ] # $path is empty
        for i in $(sfd)
            set target $(echo $(sudo ls -t --time creation "/$i") | awk '{print $NF}')

            if [ -n "$target" ]
                if confirm "Delete '/$i/$target'?"
                    sudo btrfs subv delete "/$i/$target"
                end
            else
                info "no snapshots to delete in /$i, skipping deletion of: /$i/$target"
            end
        end
    else
        set target $(echo $(sudo ls -t --time creation "$path/.snapshots") | awk '{print $NF}')

        if [ -n "$target" ]
            then
            if confirm "Delete '$path/.snapshots/$target'?"
                sudo btrfs subv delete "$path/.snapshots/$target"
            end
        else
            info "no snapshots to delete in '$path/.snapshots/', skipping deletion of: $path/.snapshots/$target"
        end
    end
end

function snapList
    if [ -z "$path" ] # if $path is empty
        sudo btrfs subv list -st /
    else
        sudo btrfs subv list -sto "$path"
    end
end

function diskUsage
    info "be patient please! this may take a while:"
    if [ -z "$path" ]
        for i in $(sfd)
            sudo btrfs filesystem du -s "/$i"
        end
    else
        sudo btrfs filesystem du -s "$path/.snapshots"
    end
end

function subvConvert --description 'takes a path and converts it to a subvolume, effectively excluding it from parent snapshots
returns 1 if path is already a subvolume, not a btrfs filesystem, or no arguments are passed
This function can cause unhandleable errors and therefore exit the program'
    if path is $argv

        set convTarget $(path normalize $argv) # remove trailing slash to avoid trying to move the folder to a subdirectory of itself, due to use of concatenation

        # if $convTarget is NOT a btrfs subvolume but is still on a btrfs filesystem
        if [ ! "$(stat --format=%i "$convTarget")" -eq 256 ] && [ "$(stat -f --format=%T "$convTarget")" = btrfs ]

            if not confirm "Convert '$convTarget' to a subvolume of the same name?"
                exit
            end

            sudo mv "$convTarget" "$convTarget.old" || exit
            sudo btrfs subv create "$convTarget" || exit
            sudo chown "$USER" "$convTarget" || exit
            sudo mv "$convTarget.old/*" "$convTarget/" || exit
            sudo rm -rf "$convTarget.old"
            return
        else
            return 1
        end

    end

    return 1
end

argparse h/help p/path= q/quiet n/name C/create= S/snapshot D/delete-snapshot L/list-snapshots U/disk-usage E/exclude-directory= G/update-grub -- $argv
or exit

if test -n "$_flag_h"
    print_usage
    exit
end

set -g name $_flag_n
set -g quiet $_flag_q
set -g path $_flag_p

subvConvert "$_flag_E"

if test -n "$_flag_C"
    subvCreate "$_flag_C"
end

if test -n "$_flag_D"
    snapDelete
end

if test -n "$_flag_S"
    snapTake
end

if test -n "$_flag_G"
    sudo grub-mkconfig -o /boot/grub/grub.cfg
end

if test -n "$_flag_U"
    diskUsage
end

if test -n "$_flag_L"
    snapList
end
